#!name=JD链路诊断v2（临时）
#!desc=对照定位 http-response 不触发的根因，看完结果即删
#!system=ios

[Script]
# 用途：A 已验证会命中，保留作对照
http-request ^https?://api\.m\.jd\.com/ script-path=https://cdn.jsdelivr.net/gh/Alwaysbesideyou/Quantumult-X-Clash@main/loon/jd-jingfen/jd_test.js, tag=诊断A-请求链路

# 用途：B2 纯字面正则（无分组无|），不带 requires-body——测「响应规则+简单正则」是否触发
http-response ^https://api\.m\.jd\.com/client\.action\?functionId=wareBusiness script-path=https://cdn.jsdelivr.net/gh/Alwaysbesideyou/Quantumult-X-Clash@main/loon/jd-jingfen/jd_test.js, tag=诊断B2-纯字面

# 用途：B3 正式插件同款正则+requires-body——测「分组正则+body」是否触发
http-response ^https?://api\.m\.jd\.com/(client\.action|api)\?functionId=(wareBusiness|serverConfig|basicConfig|lite_wareBusiness|pingou_item) script-path=https://cdn.jsdelivr.net/gh/Alwaysbesideyou/Quantumult-X-Clash@main/loon/jd-jingfen/jd_test.js, requires-body=true, tag=诊断B3-原样带body

# 用途：C 宽泛响应规则（会很吵，看完即删）——测「响应规则」这个大类是否工作
http-response ^https?://api\.m\.jd\.com/ script-path=https://cdn.jsdelivr.net/gh/Alwaysbesideyou/Quantumult-X-Clash@main/loon/jd-jingfen/jd_test.js, tag=诊断C-宽泛响应

[MITM]
hostname = api.m.jd.com

#!name=京粉自返利转链
#!desc=京东APP自动抓CK+商品页京粉转链，通知点击跳回商品页
#!system=ios

[Script]
# 用途：api.m.jd.com 请求——脚本内按 functionId 分流：抓 pt_key/pt_pin（本地存储，不外传），商品接口弹请求心跳
# 修改原因(2026-11-22): 换策略——带 ?functionId= 查询段的正则真机从未触发（诊断 v2 实证：
#   宽泛规则 A/C 稳定弹，B2/B3 与原插件两条查询正则全部静默），规则只做宽泛匹配，目标判定移到脚本内
http-request ^https?://api\.m\.jd\.com/ script-path=https://cdn.jsdelivr.net/gh/Alwaysbesideyou/Quantumult-X-Clash@main/loon/jd-jingfen/jd_jingfen_convert.js, tag=京粉转链

# 用途：api.m.jd.com 响应——脚本内分流：商品页抽分享链接→京粉转链→弹通知；serverConfig/basicConfig 清 httpdns 防绕过 MITM；其余静默放行
# 修改原因(2026-11-22): 同上换宽泛正则；不带 requires-body/timeout——诊断 C（无 flag 无 timeout）实证 $response.body 可读
http-response ^https?://api\.m\.jd\.com/ script-path=https://cdn.jsdelivr.net/gh/Alwaysbesideyou/Quantumult-X-Clash@main/loon/jd-jingfen/jd_jingfen_convert.js, tag=京粉转链

[MITM]
hostname = api.m.jd.com
